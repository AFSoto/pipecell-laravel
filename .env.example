APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# WhatsApp Cloud API (Meta): aviso al cliente cuando la reparación queda "Arreglado".
# Si WHATSAPP_TOKEN o WHATSAPP_PHONE_NUMBER_ID están vacíos, no se envía nada.
# Con Cosend (mismo número del local): WHATSAPP_API_URL=https://api.cosend.app,
# WHATSAPP_TOKEN = la clave de conexión (csk_live_...) y WHATSAPP_PHONE_NUMBER_ID = el
# Phone number ID de Meta del número. Vacía, la API es la de Meta directo.
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v26.0
WHATSAPP_PLANTILLA_LISTA=reparacion_lista
WHATSAPP_IDIOMA=es
# Webhook de entrega (https://tudominio.com/webhooks/whatsapp). APP_SECRET es el secreto
# con el que llegan firmados los avisos: con Cosend, el signing secret del número (pestaña
# Developer); con Meta directo, el App Secret (Configuración de la app → Básica).
# VERIFY_TOKEN solo lo usa Meta directo: lo inventas tú y lo pones igual en Meta.
# Sin APP_SECRET no se confirma si el aviso llegó.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Tiempo real con Pusher Channels (plan Sandbox, gratuito). Con null no se envía
# nada y cada pantalla se actualiza al recargar. Para activarlo:
#   1. Copia las App Keys de tu app en dashboard.pusher.com:
#      app_id → PUSHER_APP_ID, key → PUSHER_APP_KEY, secret → PUSHER_APP_SECRET
#      (el cluster tiene que ser el mismo con que creaste la app: mt1).
#   2. Cambia BROADCAST_CONNECTION de null a pusher.
#   3. Corre npm run build: las VITE_ quedan dentro del JS compilado.
# La key es pública; el secret nunca llega al navegador.
BROADCAST_CONNECTION=null
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

VITE_APP_NAME="${APP_NAME}"
