VITE_APP_NAME="${APP_NAME}"

# Tiempo real con Pusher Channels (plan Sandbox, gratuito). Con null no se envía
# nada y cada pantalla se actualiza al recargar.
# OJO: este archivo está en git (y en GitHub). No pongas aquí las claves: llénalas
# solo en el .env del servidor. Allá:
#   1. Copia las App Keys de tu app en dashboard.pusher.com:
#      app_id → PUSHER_APP_ID, key → PUSHER_APP_KEY, secret → PUSHER_APP_SECRET
#      (el cluster tiene que ser el mismo con que creaste la app: mt1).
#   2. Cambia BROADCAST_CONNECTION de null a pusher.
#   3. Corre php artisan config:cache.
# Las VITE_ no hacen nada en el servidor: el JS se compila en tu PC con npm run build.
BROADCAST_CONNECTION=null
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
